SET SESSION cte_max_recursion_depth = 100000;

INSERT INTO product (name, price, stock, description, status, category, created_at, updated_at)
SELECT
    CONCAT(
        ELT(cat_idx,
            '스마트폰', '노트북', '태블릿', '이어폰', '스마트워치', '모니터'),
        ' ',
        ELT(1 + FLOOR(RAND() * 5), 'Pro', 'Lite', 'Plus', 'Air', 'Max'),
        ' ',
        FLOOR(RAND() * 900 + 100)
    ) AS name,
    (FLOOR(RAND() * 300) + 1) * 10000 AS price,
    FLOOR(RAND() * 201) AS stock,
    CONCAT('자동 생성된 더미 상품 설명입니다. 상품번호 ', seq, '번.') AS description,
    CASE
        WHEN RAND() < 0.7 THEN 'ON_SALE'
        WHEN RAND() < 0.9 THEN 'SOLD_OUT'
        ELSE 'DISCONTINUED'
        END AS status,
    ELT(cat_idx,
        'SMARTPHONE', 'LAPTOP', 'TABLET', 'EARPHONES', 'SMARTWATCH', 'MONITOR') AS category,
    DATE_SUB(NOW(), INTERVAL FLOOR(RAND() * 730) DAY) - INTERVAL FLOOR(RAND() * 86400) SECOND AS created_at,
    NOW() AS updated_at
FROM (
    WITH RECURSIVE seq_gen AS (
        SELECT 1 AS seq
        UNION ALL
        SELECT seq + 1 FROM seq_gen WHERE seq < 60000
    )
    SELECT seq, 1 + FLOOR(RAND() * 6) AS cat_idx FROM seq_gen
) AS numbers;